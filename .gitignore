# Artefacts d'entraînement — volumineux et reproductibles, jamais versionnés.
# Convention de nommage pour les retrouver : runs/<pilote>-<AAAAMMJJ>-<HHMMSS>-<algo>/
runs/*
!runs/.gitkeep
recordings/*
!recordings/.gitkeep
*.npz
events.out.tfevents.*

# Exception : les runs gardés par `make garder` sont versionnés, courbes comprises.
# garder.py n'y copie jamais de modèle ni d'enregistrement.
!archives/**/events.out.tfevents.*

# Exception : fixture de test du simulateur fourni, elle fait partie de son code
!simulation/gym/f110_gym/unittest/*.npz

# Modèles.
# Les modèles intermédiaires restent hors du suivi, mais ceux qui partent au
# tournoi sont un livrable : submission/<pilote>/model.onnx est versionné.
*.onnx
*.onnx.data
!submission/*/model.onnx
!submission/*/model.onnx.data

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Système et éditeurs
.DS_Store
.idea/
.vscode/

# Simulateur fourni par Epitech — 163 fichiers, ~12 Mo, non versionné.
# Chaque membre télécharge l'archive et la décompresse ici. Version de référence
# notée dans CONTRIBUTING.md : tout le monde doit avoir la même.
simulation/

# Manifestes de comparaison du simulateur, locaux
manifest-*.txt
